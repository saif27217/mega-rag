#!/home/sak/.hermes/rag-env/bin/python3
"""
Qdrant RAG Engine — Multi-collection semantic search
=====================================================
Flow: User query → Nomic embed → Qdrant search → LLM context → Answer

Usage:
  rag --collection vdc "Total PSA reference range"
  rag --collection biochem-v1 --top-k 10 "creatine kinase normal values"
  rag --collection harrison-22nd --chat
  rag --json "symptoms of vitamin D deficiency"          # defaults to sports-medicine
  rag --list                                               # list all collections
"""

import argparse, json, os, re, sys, textwrap
from typing import Optional

# ── Qdrant Cloud Config ────────────────────────────────────────────────────

# Read from env vars or ~/.hermes/.env; fallback for backward compat
QDRANT_URL = os.environ.get("QDRANT_URL") or ""
QDRANT_API_KEY = os.environ.get("QDRANT_API_KEY") or ""

def _resolve_qdrant_creds():
    global QDRANT_URL, QDRANT_API_KEY
    if QDRANT_URL and QDRANT_API_KEY:
        return
    try:
        with open(os.path.expanduser("~/.hermes/.env")) as f:
            for line in f:
                line = line.strip()
                if line.startswith("QDRANT_URL="):
                    QDRANT_URL = line.split("=", 1)[1]
                elif line.startswith("QDRANT_API_KEY="):
                    QDRANT_API_KEY = line.split("=", 1)[1]
    except Exception:
        pass

# ── Collection Definitions ──────────────────────────────────────────────────

